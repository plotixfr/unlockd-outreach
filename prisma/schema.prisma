generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Prospect {
  id                String    @id @default(cuid())
  firmaNaziv        String
  kontaktIme        String?
  kontaktPozicija   String?
  email             String    @unique
  website           String?
  instagram         String?
  nisa              String
  grad              String
  opisFirme         String?
  kvalitetSajta     Int?
  napomena          String?
  source            String?
  sourceQuery       String?
  externalId        String?
  autoGenerated     Boolean   @default(false)
  autoScheduled     Boolean   @default(false)
  briefId           String?
  brief             SearchBrief? @relation(fields: [briefId], references: [id], onDelete: SetNull)
  status            String    @default("New")
  datumPrvogMaila   DateTime?
  datumFollowUp1    DateTime?
  datumFollowUp2    DateTime?
  datumFollowUp3    DateTime?
  datumOdgovora     DateTime?
  scheduledInitial   DateTime?
  scheduledFollow1   DateTime?
  scheduledFollow2   DateTime?
  scheduledFollow3   DateTime?
  podsjetnikDatum    DateTime?
  podsjetnikNapomena String?
  siteSnapshot       Json?
  siteSnapshotAt     DateTime?
  pagespeed          Json?
  pagespeedAt        DateTime?
  decisionMakers     Json?
  qualityScore       Int?
  qualityNote        String?      @db.Text
  dealStage          String?
  dealValue          Float?
  dealStageAt        DateTime?
  mockupUrl          String?
  mockupPrompt       String?      @db.Text
  mockupAt           DateTime?
  proposalContent    Json?
  proposalAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  emails             Email[]
  conversions        Conversion[]
  notes              Note[]
  replies            Reply[]
}

model Email {
  id            String    @id @default(cuid())
  prospectId    String
  prospect      Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  tip           String
  subject       String
  body          String    @db.Text
  poslat        Boolean   @default(false)
  poslatAt      DateTime?
  otvoren       Boolean   @default(false)
  otvorenAt     DateTime?
  subjectB      String?   @db.Text
  activeSubject String    @default("A")
  resendId         String?
  messageId        String?
  calendlyClicked  Boolean   @default(false)
  calendlyClickedAt DateTime?
  createdAt        DateTime  @default(now())
}

model Reply {
  id             String   @id @default(cuid())
  prospectId     String
  prospect       Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  fromAddr       String
  subject        String?
  body           String   @db.Text
  receivedAt     DateTime
  imapUid        String?  @unique
  classification String?
  draft          String?  @db.Text
  createdAt      DateTime @default(now())
}

model SearchBrief {
  id               String   @id @default(cuid())
  name             String
  niche            String
  city             String?
  country          String   @default("FR")
  query            String?
  minRating        Float?
  minReviews       Int?
  maxPerRun        Int      @default(5)
  qualityThreshold Int      @default(6)
  autoGenerate     Boolean  @default(true)
  autoSchedule     Boolean  @default(true)
  active           Boolean  @default(true)
  lastRunAt        DateTime?
  totalDiscovered  Int      @default(0)
  totalQualified   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  prospects        Prospect[]
  runs             DiscoveryRun[]
}

model DiscoveryRun {
  id           String   @id @default(cuid())
  briefId      String
  brief        SearchBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  status       String   @default("running")
  found        Int      @default(0)
  emailsFound  Int      @default(0)
  created      Int      @default(0)
  qualified    Int      @default(0)
  scheduled    Int      @default(0)
  errors       Json?
  notes        String?  @db.Text
}

model CaseStudy {
  id          String   @id @default(cuid())
  title       String
  nisa        String
  summary     String   @db.Text
  metricLabel String?
  metricValue String?
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversion {
  id                 String   @id @default(cuid())
  prospectId         String
  prospect           Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  vrijednostProjekta Float
  datumKonverzije    DateTime
  napomena           String?
  createdAt          DateTime @default(now())
}

model Note {
  id         String   @id @default(cuid())
  prospectId String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  tekst      String   @db.Text
  createdAt  DateTime @default(now())
}

model NicheTemplate {
  nisa       String   @id
  promptHint String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
