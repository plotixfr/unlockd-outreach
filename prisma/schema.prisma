generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Prospect {
  id                String    @id @default(cuid())
  firmaNaziv        String
  kontaktIme        String?
  kontaktPozicija   String?
  email             String    @unique
  website           String?
  instagram         String?
  nisa              String
  grad              String
  opisFirme         String?
  kvalitetSajta     Int?
  napomena          String?
  status            String    @default("New")
  datumPrvogMaila   DateTime?
  datumFollowUp1    DateTime?
  datumFollowUp2    DateTime?
  datumFollowUp3    DateTime?
  datumOdgovora     DateTime?
  scheduledInitial  DateTime?
  scheduledFollow1  DateTime?
  scheduledFollow2  DateTime?
  scheduledFollow3  DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  emails            Email[]
  conversions       Conversion[]
}

model Email {
  id          String    @id @default(cuid())
  prospectId  String
  prospect    Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  tip         String
  subject     String
  body        String    @db.Text
  poslat      Boolean   @default(false)
  poslatAt    DateTime?
  otvoren     Boolean   @default(false)
  otvorenAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Conversion {
  id                 String   @id @default(cuid())
  prospectId         String
  prospect           Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  vrijednostProjekta Float
  datumKonverzije    DateTime
  napomena           String?
  createdAt          DateTime @default(now())
}
